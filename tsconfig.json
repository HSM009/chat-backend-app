{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],

    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": ["src/**/*.ts", "src/**/*.d.ts"]
}
